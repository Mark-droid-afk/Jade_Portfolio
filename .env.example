# ---- Gurrabot (the AI chatbot) ----
# Free key from https://console.groq.com/keys
GROQ_API_KEY=
# Optional. Leave empty to use the default (openai/gpt-oss-120b). Never put the API key here.
GROQ_MODEL=

# ---- Your own contact form, saved chats, activity, and admin editing (Supabase, free) ----
# Run supabase/schema.sql in the Supabase SQL editor, then copy these from Project Settings > API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Email alerts (Resend, free) ----
# Emails you new messages and site errors. Needs both values.
RESEND_API_KEY=
OWNER_EMAIL=

# ---- Admin page at /admin ----
# Pick a long password. ADMIN_SECRET is optional (signs the login cookie).
ADMIN_PASSWORD=
ADMIN_SECRET=

# ---- Optional ----
# Higher GitHub API limit for the live repo stats (a token with no permissions is enough)
GITHUB_TOKEN=
# Fallback contact form if you skip Supabase and Resend: https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_KEY=
# Your live URL, including https:// (share previews, sitemap)
NEXT_PUBLIC_SITE_URL=
